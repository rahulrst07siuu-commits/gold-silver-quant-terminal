# =====================================================================
# MCX GOLD & SILVER QUANTITATIVE TERMINAL — ENVIRONMENT CONFIGURATION
# =====================================================================
# Instructions:
# 1. Copy or rename this file to .env:
#    cp .env.example .env
# 2. Fill in your personal configuration below.
# 3. NEVER commit your actual .env file to GitHub or any public repository.
# =====================================================================

# ---------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ---------------------------------------------------------------------
APP_ENV=development
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_SERVER_HEADLESS=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# 2. MARKET DATA PROVIDER CONFIGURATION
# ---------------------------------------------------------------------
# Select active live provider: DHAN | KITE | FALLBACK_MOCK
MARKET_DATA_PROVIDER=DHAN

# Primary Provider: DhanHQ API v2 (https://dhanhq.co)
# Obtain Client ID & Token from Dhan Web > Profile > Access DhanHQ APIs
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_dhan_jwt_access_token_here

# Fallback Provider: Zerodha Kite Connect v3 (https://kite.trade)
# Obtain API Key & Access Token from developers.kite.trade
KITE_API_KEY=your_kite_api_key_here
KITE_ACCESS_TOKEN=your_kite_access_token_here

# ---------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ---------------------------------------------------------------------
DB_PATH=database/mcx_market_data.db
DB_TIMEOUT_SECONDS=30
DB_ENABLE_WAL=true

# ---------------------------------------------------------------------
# 4. PAPER TRADING & RISK MANAGEMENT (SIMULATION ONLY)
# ---------------------------------------------------------------------
PAPER_INITIAL_CAPITAL=1000000.0
PAPER_MAX_DRAWDOWN_LIMIT_PCT=0.10
PAPER_MAX_POSITION_SIZE_LOTS=5
PAPER_DEFAULT_STOP_LOSS_PCT=0.015
PAPER_BROKERAGE_PER_ORDER_INR=20.0
PAPER_SLIPPAGE_BPS=2.0

# ---------------------------------------------------------------------
# 5. MODEL MONITORING & RETRAINING THRESHOLDS
# ---------------------------------------------------------------------
DRIFT_P_VALUE_THRESHOLD=0.05
CHALLENGER_MIN_IMPROVEMENT_PCT=0.03
AUTO_RETRAIN_INTERVAL_HOURS=24
